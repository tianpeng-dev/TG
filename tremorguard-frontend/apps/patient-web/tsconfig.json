{
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "rootDir": "./src",
    "outDir": "./dist",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "baseUrl": "./src",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@/*": ["./*"],
      "@components/*": ["./components/*"],
      "@pages/*": ["./pages/*"],
      "@styles/*": ["./styles/*"],
      "@data/*": ["./data/*"]
    }
  },
  "include": ["src/**/*"]
}
